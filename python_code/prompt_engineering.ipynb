   "source": [
    "## Give the model time to think (Chain of thought or CoT technique)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "7a64620b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{\n",
      "    \"steps\": \"Step 1: 259 / 2 = 129.5\\nStep 2: 129.5 * 8654 = 1119983\\nStep 3: 1119983 + 91072 = 1137055\",\n",
      "    \"result\": 1137055\n",
      "}\n"
     ]
    }
   ],
   "source": [
    "user_prompt = \"\"\"\n",
    "Calculate the result of this equation exactly: 259 / 2 * 8654 + 91072 \n",
    "\n",
    "You MUST follow BEDMAS (order of operations) and show all steps clearly in the \"steps\" field. \n",
    "Your output MUST be valid JSON ONLY and look like this:\n",
    "\n",
    "{\n",
    "    \"steps\": \"Step-by-step calculation with actual numbers\",\n",
    "    \"result\": final_numeric_result\n",
    "}\n",
    "\n",
    "Do not leave any field empty. Do not add extra text outside JSON. Perform all calculations yourself.\n",
    "\"\"\"\n",
    "\n",
    "messages = [{'role': 'user', 'content': user_prompt}]\n",
    "\n",
    "response = get_chatbot_response(messages)\n",
    "\n",
    "# Extract JSON robustly\n",
    "match = re.search(r\"\\{.*\\}\", response, re.DOTALL)\n",
    "if not match:\n",
    "    raise ValueError(\"Model did not return any JSON-like output\")\n",
    "\n",
    "json_str = match.group(0)\n",
    "\n",
    "# Replace single quotes with double quotes if needed\n",
    "json_str = json_str.replace(\"'\", '\"')\n",
    "\n",
    "# Remove trailing commas (common model mistakes)\n",
    "json_str = re.sub(r\",\\s*}\", \"}\", json_str)\n",
    "json_str = re.sub(r\",\\s*]\", \"]\", json_str)\n",
    "\n",
    "# Load as JSON\n",
    "clean_json = json.loads(json_str)\n",
    "\n",
    "# Ensure result is numeric\n",
    "if isinstance(clean_json.get(\"result\"), str):\n",
    "    clean_json[\"result\"] = float(clean_json[\"result\"].replace(',', '').strip())\n",
    "\n",
    "print(json.dumps(clean_json, indent=4))"
   ]
  },
